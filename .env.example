NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/cleaning_ops
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cleaning_ops
DB_USER=app_user
